VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Cloud Run (GitHub Actions "Deploy to Cloud Run"): set the same variables as repo secrets
# VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY — baked in at image build. Add the Cloud Run URL to Supabase Auth redirect URLs.

# Admin panel (/admin): insert into public.user_roles (user_id = auth.users.id, role = 'admin').
# The app uses RPC is_admin + a direct user_roles read; apply migration 20260421180000_is_admin_from_user_roles.sql
# in the SQL editor (or `supabase db push`) so is_admin() exists, matches user_roles, and RLS allows reading your own row.
# If SQL Editor shows is_admin=true but the app still says non-admin: VITE_SUPABASE_URL must be the SAME project
# (Dashboard → Settings → API → Project URL). In Table Editor, ensure `user_roles` is under schema `public` and exposed to the Data API.

# Optional: override desk / support email (default is rishtewalesardarji@gmail.com)
# VITE_DEFAULT_APP_EMAIL=

# Optional: Stripe Payment Link or Checkout URL for monthly subscription (replaces simulated modal)
# VITE_STRIPE_SUBSCRIPTION_CHECKOUT_URL=https://buy.stripe.com/...

# Canonical production URL (for Open Graph / JSON-LD / sitemap absolute URLs)
# VITE_PUBLIC_SITE_URL=https://rishtewalesardarji.in

# Google AdSense client ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
# VITE_ADSENSE_CLIENT=
